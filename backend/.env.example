# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/freelancePlatform

# Frontend URL for CORS & Cookie authentication
# In production on Render, set this to your Vercel deployment URL (without trailing slash)
# e.g. https://your-project.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# JWT Secret Key for authenticating sessions
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
